{
  "name": "worldridr-studio",
  "productName": "WorldRidr Studio",
  "version": "0.1.0",
  "description": "WorldRidr Studio: world editor for the worldridr driving simulator (OpenStreetMap import, roads, buildings, terrain, Lua scripts, git-based shared maps). Built on Forge Studio.",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run engine && vite",
    "build": "npm run engine && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "app:dev": "concurrently -k \"vite --strictPort --port 5173\" \"wait-on tcp:5173 && cross-env FORGE_DEV_URL=http://localhost:5173 electron .\"",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "engine": "node scripts/build-engine.mjs",
    "engine:test": "node scripts/build-engine.mjs --test",
    "i18n:check": "node scripts/i18n-check.mjs",
    "server:build": "node scripts/build-server.mjs",
    "server:test": "node scripts/build-server.mjs --test",
    "server": "node scripts/run-server.mjs",
    "player": "electron . --player",
    "player:dev": "concurrently -k \"vite --strictPort --port 5173\" \"wait-on tcp:5173 && cross-env FORGE_DEV_URL=http://localhost:5173 electron . --player\"",
    "dist": "node scripts/dist.mjs",
    "dist:studio": "node scripts/dist.mjs studio",
    "dist:player": "node scripts/dist.mjs player",
    "dist:server": "node scripts/dist.mjs server",
    "dist:linux": "node scripts/dist-linux-wsl.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "wait-on": "^9.5.1"
  },
  "author": "Forge"
}
